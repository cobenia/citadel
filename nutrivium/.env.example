# Notion API Configuration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# OpenAI / LiteLLM Configuration
# La key es la virtual key de LiteLLM (key_alias=nutrivium), no una key de OpenAI.
OPENAI_API_KEY=your_litellm_virtual_key_here
# Proxy LiteLLM (OpenAI-compatible). Por defecto http://litellm:4000/v1.
# Dejar vacío para usar directamente la API oficial de OpenAI.
OPENAI_BASE_URL=http://litellm:4000/v1

# Logging Configuration
LOG_LEVEL=info

# OpenAI Model Configuration (alias de LiteLLM)
OPENAI_MODEL=gpt-5.5

# App Configuration
APP_NAME=nutrivium
APP_VERSION=0.0.1
